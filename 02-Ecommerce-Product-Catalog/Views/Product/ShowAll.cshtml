@model List<Product>

<table class="table table-bordered table-hover">

    <thead>
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Image</th>
    </tr>
    </thead>

    <tbody>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.ProductId</td>
            <td>@product.ProductName</td>
            <td>@product.ProductPrice</td>

            <td>
                <img src="/images/@product.ImageURL" style="width:40px" />
            </td>
            <td>
                <a asp-controller="Product" asp-action="ProductId" asp-route-id="@product.ProductId" class="btn btn-primary">
                    Show Details
                </a>
            </td>
        </tr>
    }
    </tbody>

</table>